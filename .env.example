# --- Encryption key for WhatsApp access tokens at rest ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# --- Team-invite token keypair (@quantumvault/sdk, ML-DSA-87) ---
# Generate all three with: npm run gen:invite-keys
TEAM_INVITE_SIGNING_KEY=""
TEAM_INVITE_VERIFYING_KEY=""
TEAM_INVITE_ENCRYPT_KEY=""
# Optional — 32-byte hex; defaults to a stable per-deploy seed if blank
TEAM_INVITE_CHAIN_SEED=""

# --- Vercel cron auth (random secret; cron headers must include this) ---
CRON_SECRET=""

# --- Architect (AI design generator) ---
# Anthropic API for the LLM narrative (https://console.anthropic.com)
ANTHROPIC_API_KEY=""
# Replicate API token for AI-generated render images (https://replicate.com/account/api-tokens)
# Without this, the renderer returns a placeholder image URL.
REPLICATE_API_TOKEN=""

# --- Rate limiting (Upstash Redis; optional — in-memory fallback used if missing) ---
# Get free credentials at https://console.upstash.com → create Redis DB → REST API tab
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Email (Resend; required for lead follow-ups) ---
# https://resend.com → API Keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="PlotBroker <hello@yourdomain.com>"

# --- Team invite tokens (optional — enables post-quantum signed tokens via @sigvault/sdk) ---
# Generate with: npm run gen:invite-keys
# When set, team-invite links are ML-DSA-87 signed; when blank, falls back to HMAC over ENCRYPTION_KEY.
TEAM_INVITE_SIGNING_KEY=""
TEAM_INVITE_VERIFYING_KEY=""
TEAM_INVITE_ENCRYPT_KEY=""

# --- Razorpay (subscriptions) ---
# https://dashboard.razorpay.com → API keys (use test_ keys in development)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Created in Razorpay dashboard → Subscriptions → Plans (or via API). Monthly INR plans.
RAZORPAY_PLAN_ID_PRO=""           # e.g. plan_QXXXXXXXXXX
RAZORPAY_PLAN_ID_ENTERPRISE=""
# Razorpay → Webhooks → Add → use this secret to verify signatures
RAZORPAY_WEBHOOK_SECRET=""
# Public key (safe in browser) — used by Razorpay Checkout JS
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- WhatsApp Business Cloud API (optional, per-org keys are stored in DB) ---
# These are fallback/default credentials; production stores per-org config in WhatsAppConfig table
WHATSAPP_DEFAULT_PHONE_NUMBER_ID=""
WHATSAPP_DEFAULT_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="changeme"

# --- Observability (Sentry; optional — SDK no-ops when unset) ---
# Get a DSN at https://sentry.io → Project → Client Keys
# SENTRY_DSN drives server-side capture; NEXT_PUBLIC_SENTRY_DSN drives browser-side.
# In most deploys you set both to the same value.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Optional — tracing sample rates (0.0–1.0). Defaults: server 0.1, client 0.2.
SENTRY_TRACES_SAMPLE_RATE=""
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=""
# Optional — environment label shown in Sentry dropdown (defaults to NODE_ENV / VERCEL_ENV).
SENTRY_ENVIRONMENT=""
# Optional — source-map upload (CI step). Get one at https://sentry.io → Settings → Auth Tokens.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
